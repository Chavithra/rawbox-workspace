    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@rawbox/plugin": "^0.1.0",
    "@rawbox/runner": "^0.1.0",
    "@rawbox/store": "^0.1.0",
    "ejs": "^6.0.1",
    "neverthrow": "^8.2.0",
    "picocolors": "^1.1.1",
    "redis": "^6.2.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.1",
    "yaml": "^2.9.0",
    "yargs": "^18.1.0"
  }
}
