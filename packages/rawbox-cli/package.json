{
  "name": "@rawbox/cli",
  "version": "0.1.0",
  "bin": {
    "rawbox-cli": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && npm run copy:ejs && chmod +x dist/index.js",
    "copy:ejs": "copyfiles -u 1 src/**/*.ejs src/**/*.md dist/",
    "start": "npm run build && node dist/index.js",
    "test": "vitest run tests",
    "test-bin": "npm run build && node dist/index.js"
  },
  "keywords": [],
  "author": "Chavithra Parana <chavithra@gmail.com>",
