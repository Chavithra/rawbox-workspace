{
  "name": "<%= pluginName %>",
  "version": "1.0.0",
  "type": "module",
  "description": "Rawbox plugin: <%= pluginName %>",
  "keywords": [
    "rawbox-plugin"
  ],
  "main": "dist/contract-registry.js",
  "exports": {
    "./contract-registry": {
      "types": "./dist/contract-registry.d.ts",
      "default": "./dist/contract-registry.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc",
    "test": "vitest run tests",
    "type-check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "@rawbox/plugin": "^<%= typeof pluginSdkVersion !== 'undefined' ? pluginSdkVersion : '0.1.0' %>"
  },
  "devDependencies": {
    "@rawbox/plugin": "^<%= typeof pluginSdkVersion !== 'undefined' ? pluginSdkVersion : '0.1.0' %>",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "license": "BSD-3-Clause"
}
