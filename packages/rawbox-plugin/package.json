      "types": "./dist/control-flow/index.d.ts",
      "default": "./dist/control-flow/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./neverthrow": {
      "types": "./dist/neverthrow.d.ts",
      "default": "./dist/neverthrow.js"
    },
    "./operation": {
      "types": "./dist/operation/index.d.ts",
      "default": "./dist/operation/index.js"
    },
    "./typebox": {
      "types": "./dist/typebox.d.ts",
      "default": "./dist/typebox.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [],
  "license": "BSD-3-Clause",
  "name": "@rawbox/plugin",
  "publishConfig": {
